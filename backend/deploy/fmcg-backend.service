[Unit]
Description=FMCG FastAPI backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/app/backend
Environment="CORS_ORIGINS=https://main.de28qzdteadcd.amplifyapp.com"
ExecStart=/home/ubuntu/app/backend/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
